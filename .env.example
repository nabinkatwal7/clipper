# Copy to .env.local and adjust. Paths may be absolute or resolved from PATH.

# --- Ollama (the only AI service) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional local speech recognizer. Windows installs under tools/whisper are auto-detected.
# CLIPPER_SPEECH_BIN=C:/path/to/whisper-cli.exe
# CLIPPER_SPEECH_MODEL=C:/path/to/ggml-base.bin
# CLIPPER_SPEECH_LANGUAGE=auto
# Set only on web replicas. All instances must share the same absolute CLIPPER_STORAGE_DIR.
# CLIPPER_COORDINATOR_URL=http://127.0.0.1:4000

# --- External tools ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
FFMPEG_THREADS=8
FFMPEG_PRESET=superfast

# --- Limits ---
MAX_UPLOAD_MB=5120
MAX_VIDEO_HOURS=12

# --- Storage and accounts ---
# Absolute path to relocate all data (accounts, workspaces, backups).
# CLIPPER_STORAGE_DIR=
# Only needed when the first account is created through a non-localhost address.
# CLIPPER_SETUP_TOKEN=
